# Copy to `.env` and adjust. NEVER commit `.env`.

APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Database. Local default is SQLite (zero setup). docker-compose overrides this with PostgreSQL.
# DATABASE_URL=postgresql+psycopg2://neurosonic:neurosonic@localhost:5432/neurosonic
POSTGRES_USER=neurosonic
POSTGRES_PASSWORD=neurosonic
POSTGRES_DB=neurosonic

# Optional LLM (any OpenAI-compatible endpoint: OpenAI, Ollama /v1, vLLM, LM Studio ...).
# Without a key the app uses a local rule-based NLP parser + extractive RAG answers.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional hosted music generation (facebook/musicgen-small via Hugging Face). Without it: local synth.
HF_API_TOKEN=

# local-tfidf (default, no downloads) | sentence-transformers (pip install sentence-transformers)
EMBEDDING_PROVIDER=local-tfidf

MAX_UPLOAD_MB=5
# Mains frequency for the notch filter (50 EU/Asia, 60 Americas)
NOTCH_HZ=50
